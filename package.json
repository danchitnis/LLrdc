{
  "name": "llrdc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLrdc: Low Latency remote desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danchitnis/llrdc.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:go": "./scripts/lint-go.sh",
    "check:modularity": "./scripts/check-file-lengths.sh",
    "client:build": "docker build -f Dockerfile.client -t llrdc-client:native .",
    "client:package": "./scripts/package-native-client.sh",
    "client:run": "./scripts/run-native-client.sh",
    "client:verify-package": "./scripts/verify-native-client-package.sh",
    "client:test": "./tests/linux-wayland-native/test-wayland-native-client.sh",
    "test:macos:browser": "./test-macos-split.sh",
    "start": "./docker-run.sh",
    "test": "npm run test:cpu:connection",
    "test:cpu:connection": "CONTAINER_IMAGE=danchitnis/llrdc:latest ./test-linux-cpu-browser.sh",
    "test:cpu": "npm run test:cpu:connection",
    "test:nvidia:connection": "./test-nvidia-browser.sh",
    "test:intel:connection": "./test-intel-browser.sh",
    "test:latency": "./scripts/benchmark-latency.sh",
    "test:latency:cpu": "./scripts/benchmark-latency.sh --accel cpu",
    "test:latency:intel": "./scripts/benchmark-latency.sh --accel intel",
    "test:latency:nvidia": "./scripts/benchmark-latency.sh --accel nvidia"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2"
  },
  "dependencies": {}
}
