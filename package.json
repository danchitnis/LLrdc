{
  "name": "llrdc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLrdc: Low Latency remote desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danchitnis/llrdc.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:go": "./scripts/lint-go.sh",
    "check:modularity": "./scripts/check-file-lengths.sh",
    "client:build": "docker build -f Dockerfile.client -t llrdc-client:native .",
    "client:package": "./scripts/package-native-client.sh",
    "client:run": "./scripts/run-native-client.sh",
    "client:verify-package": "./scripts/verify-native-client-package.sh",
    "client:test": "./tests/linux-wayland-native/test-wayland-native-client.sh",
    "client:benchmark:latency": "./tests/linux-wayland-native/benchmark-wayland-native-latency.sh",
    "start": "docker run --rm -p ${PORT:-8080}:${PORT:-8080}/tcp -p ${PORT:-8080}:${PORT:-8080}/udp -e PORT=${PORT:-8080} -e TEST_PATTERN=${TEST_PATTERN} -e FPS=${FPS:-30} -e VIDEO_CODEC=${VIDEO_CODEC:-vp8} -e HOST_UID=$(id -u) -e HDPI=${HDPI:-0} -e WEBRTC_PUBLIC_IP=${WEBRTC_PUBLIC_IP:-127.0.0.1} danchitnis/llrdc ./llrdc --port ${PORT:-8080} --fps ${FPS:-30} --video-codec ${VIDEO_CODEC:-vp8} --webrtc-public-ip ${WEBRTC_PUBLIC_IP:-127.0.0.1}",
    "test": "./test.sh",
    "test:cpu": "CONTAINER_IMAGE=danchitnis/llrdc:latest ./test.sh tests/cpu",
    "test:intel": "CONTAINER_IMAGE=danchitnis/llrdc:intel ./test.sh tests/intel",
    "test:nvidia": "./test.sh tests/nvidia",
    "test:latency": "./tests/linux-wayland-native/benchmark-wayland-native-latency.sh",
    "test:browser:chrome:nvidia": "npx playwright test tests/nvidia/wayland_direct_buffer.spec.ts"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
